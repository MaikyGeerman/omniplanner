# Postgres database. On Vercel these two are filled in automatically when you connect a
# Neon database. Locally you can paste the same values from Vercel -> Storage -> your database.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Timezone used to compute evenings/weekends
APP_TIMEZONE="Europe/Amsterdam"
